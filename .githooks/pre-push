#!/bin/sh
# Brama przed wysłaniem zmian.
#
# GitHub Actions uruchamia testy PO pushu, więc sam z siebie niczego nie zatrzyma —
# czerwony przebieg to raport, nie blokada. Ten hook jest tą blokadą po stronie
# wysyłającego: nie przepuszcza pusha, dopóki testy nie przejdą.
#
# Włączenie w świeżym klonie, raz:
#     git config core.hooksPath .githooks
#
# Obejście, gdy naprawdę trzeba wysłać mimo wszystko:
#     git push --no-verify
#
# Kolektor tego nie dotyczy: w Actions hooki się nie wykonują, a i tak commituje
# wyłącznie data/, których żaden test nie generuje.

set -e
KATALOG=$(git rev-parse --show-toplevel)
cd "$KATALOG"

echo "→ testy kolektora"
python3 -m unittest discover -s tests -q

if [ -d tests/frontend/node_modules ]; then
  echo "→ testy strony"
  # Playwright szuka przeglądarki po numerze budowy przypisanym do swojej wersji.
  # W środowisku z gotowym katalogiem przeglądarek (PLAYWRIGHT_BROWSERS_PATH) ten
  # numer bywa inny niż zainstalowany i wszystkie testy padają na „Executable
  # doesn't exist" — czyli brama zatrzymywałaby push z powodu, który z kodem nie
  # ma nic wspólnego, a to prosta droga do nawyku --no-verify. Bierzemy więc to,
  # co faktycznie leży na dysku. Na zwykłej maszynie zmienna jest pusta i nic
  # się tu nie dzieje.
  if [ -z "$PLAYWRIGHT_CHROMIUM_PATH" ] && [ -n "$PLAYWRIGHT_BROWSERS_PATH" ]; then
    for kandydat in "$PLAYWRIGHT_BROWSERS_PATH"/chromium-*/chrome-linux/chrome; do
      [ -x "$kandydat" ] && PLAYWRIGHT_CHROMIUM_PATH="$kandydat" && export PLAYWRIGHT_CHROMIUM_PATH
    done
  fi
  (cd tests/frontend && npx playwright test --reporter=line)
else
  echo "→ testy strony pominięte: brak tests/frontend/node_modules"
  echo "  zainstaluj przez  cd tests/frontend && npm ci"
  echo "  albo wyślij świadomie przez  git push --no-verify"
  exit 1
fi

echo "✓ wszystko zielone, wysyłam"
